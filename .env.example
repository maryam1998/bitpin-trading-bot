BITPIN_API_KEY=your_bitpin_api_key
BITPIN_API_SECRET=your_bitpin_api_secret
BITPIN_BASE_URL=https://api.bitpin.ir

AI_ENABLED=true
# مدل سنگین/دقیق - فقط برای تحلیل تکنیکال واقعی هر نماد (decide) استفاده می‌شود
# provider: openai یا groq (اگر کلید شما با gsk_ شروع می‌شود، از groq استفاده کنید)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=your_openai_key
# مدل ارزان/سریع برای سوالات ساده و تصمیم‌های deterministic («چی بخرم؟»،
# «موجودی چقدره؟»، چت آزاد). اگر خالی بماند، همان AI_MODEL استفاده می‌شود.
AI_MODEL_FAST=
# اختیاری: مدل/پرووایدر پشتیبان که فقط وقتی AI_MODEL به 429/TPD بخورد
# یک‌بار امتحان می‌شود (نه retry پشت‌سرهم روی همان مدل).
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
# حداکثر iteration در حلقه‌ی tool-calling (پیش‌فرض قبلی ۵ بود)
AI_MAX_TOOL_ITERATIONS=3
# مدت (ثانیه) cache تصمیم‌های AI deterministic وقتی داده‌ی واقعی ورودی تغییر نکرده
AI_DECISION_CACHE_SECONDS=180
# حلقه‌ی پس‌زمینه (run_cycle): AI فقط وقتی واقعاً برای هر نماد صدا زده
# می‌شود که این‌قدر زمان گذشته باشد یا قیمت به این درصد تغییر کرده باشد
# (نه هر poll_interval_seconds/۶۰ ثانیه برای همه‌ی نمادها - این اصلی‌ترین
# عامل رسیدن سریع به سقف TPD روزانه بود، نه چت)
AI_DECISION_MIN_INTERVAL_SECONDS=300
AI_PRICE_CHANGE_PERCENT=1.0

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

BRSAPI_URL=https://api.brsapi.ir/Market/Gold_Currency.php
COINGECKO_API_KEY=

BOT_MODE=PAPER
WATCHLIST=BTC,ETH,USDT,BNB,XRP,ADA,DOGE,SOL,DOT,LINK,GOLD,USD_IRT,EUR_IRT,GBP_IRT

POLL_INTERVAL_SECONDS=60
INTELLIGENCE_INTERVAL_SECONDS=300

MAX_POSITION_PERCENT=5.0
MAX_OPEN_POSITIONS=5
MIN_NET_EDGE=0.3
MIN_LIQUIDITY=1000

DATABASE_PATH=trading_bot.db
