# ==== Bitpin API credentials ====
# Create a read-only key first. Never commit this file with real values.
BITPIN_API_KEY=
BITPIN_API_SECRET=
BITPIN_BASE_URL=https://api.bitpin.ir

# ==== Mode ====
# OBSERVE = read-only, zero trading (default, safe)
# PAPER   = simulated trading with real market data, zero real orders
# LIVE    = real trading — requires BOTH flags below AND everything in
#           section 14 of the spec before a single order can be sent.
BOT_MODE=OBSERVE
LIVE_TRADING=false
LIVE_TRADING_CONFIRMED=false

# ==== Risk limits ====
MAX_POSITION_PERCENT=5
MAX_ASSET_EXPOSURE_PERCENT=20
MAX_TOTAL_EXPOSURE_PERCENT=60
MAX_DAILY_LOSS_PERCENT=3
MAX_OPEN_POSITIONS=5
MAX_SLIPPAGE_PERCENT=0.5
MIN_LIQUIDITY=1000
MIN_NET_EDGE=0.3
MAX_CONSECUTIVE_LOSSES=4

# ==== Polling ====
POLL_INTERVAL_SECONDS=15
STALE_DATA_SECONDS=60

# ==== Telegram (optional) ====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==== SMS (optional) ====
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_PHONE_NUMBER=

# ==== Database ====
DATABASE_PATH=trading_bot.db
